<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wheeltec_mycobot_bringup</name>
  <version>0.0.1</version>
  <description>
    Bringup launch files for the aggregated WHEELTEC R680 + myCobot 280 robot.
    Provides camera, lidar, arm controller, car controller and all-in-one
    launch files that wire together the aggregated robot description with the
    base driver, sensors, arm ros2_control and MoveIt2.
  </description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Aggregated robot description (xacro / meshes) -->
  <exec_depend>wheeltec_mycobot_description</exec_depend>

  <!-- WHEELTEC mobile base driver + EKF config -->
  <exec_depend>turn_on_wheeltec_robot</exec_depend>

  <!-- Camera and lidar sensor drivers -->
  <exec_depend>astra_camera</exec_depend>
  <exec_depend>lslidar_driver</exec_depend>

  <!-- myCobot arm ros2_control hardware interface + driver -->
  <exec_depend>mycobot280_moveit2_control</exec_depend>
  <!-- MoveIt2 config + move_group launch -->
  <exec_depend>mycobot_moveit_config</exec_depend>

  <!-- EKF state estimation for the mobile base -->
  <exec_depend>robot_localization</exec_depend>

  <!-- Visualization + robot model processing -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
