<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openmv_camera</name>
  <version>0.1.0</version>
  <description>Grab frames from an OpenMV camera over its USB CDC virtual serial port (raw-REPL protocol) and publish sensor_msgs/Image on /openmv/image_raw.</description>
  <maintainer email="admi@todo.todo">admi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
