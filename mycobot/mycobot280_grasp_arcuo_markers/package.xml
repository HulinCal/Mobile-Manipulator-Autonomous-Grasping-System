<?xml version="1.0"?>
<package format="3">
  <name>mycobot280_grasp_arcuo_markers</name>
  <version>0.1.0</version>
  <description>Detect ArUco markers (ID 1/2/3) and compute MoveIt target pose for mycobot280 grasping.</description>
  <maintainer email="hl@example.com">hl</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>aruco_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>easy_handeye2</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>mycobot280_moveit2_control</exec_depend>
  <exec_depend>aruco_ros</exec_depend>
  <exec_depend>astra_camera</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
